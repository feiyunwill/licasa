# Private Qt plugins use private APIs. These identities are intentionally exact;
# adding a distro requires qualified source inputs, never a version-range escape.
get_filename_component(LICASA_RUNTIME_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(LICASA_RUNTIME_PROFILE "ubuntu-6.4.2" CACHE STRING "Qualified private Qt runtime profile")
set_property(CACHE LICASA_RUNTIME_PROFILE PROPERTY STRINGS ubuntu-6.4.2 debian-6.8.2)
if(LICASA_RUNTIME_PROFILE STREQUAL "ubuntu-6.4.2")
    set(LICASA_RUNTIME_QT_VERSION "6.4.2")
    set(LICASA_RUNTIME_FFMPEG_LOCK "${CMAKE_CURRENT_LIST_DIR}/../packaging/qt-ffmpeg.lock.json")
elseif(LICASA_RUNTIME_PROFILE STREQUAL "debian-6.8.2")
    set(LICASA_RUNTIME_QT_VERSION "6.8.2")
    set(LICASA_RUNTIME_FFMPEG_LOCK "${CMAKE_CURRENT_LIST_DIR}/../packaging/qt-ffmpeg-debian.lock.json")
else()
    message(FATAL_ERROR "Unknown LICASA_RUNTIME_PROFILE: ${LICASA_RUNTIME_PROFILE}")
endif()

function(licasa_verify_quick_runtime library)
    if(NOT LICASA_RUNTIME_PROFILE STREQUAL "ubuntu-6.4.2")
        message(FATAL_ERROR "The selected runtime profile has no qualified private Qt Quick backport")
    endif()
    get_filename_component(runtime_dir "${library}" DIRECTORY)
    if(NOT EXISTS "${runtime_dir}/build.json")
        message(FATAL_ERROR "Private Qt Quick requires its matching build.json provenance; rebuild with tools/build_qt_backport.py")
    endif()
    file(READ "${runtime_dir}/build.json" receipt)
    foreach(field runtime_profile qt_version library_sha256 source_sha256)
        string(JSON actual_${field} ERROR_VARIABLE json_error GET "${receipt}" "${field}")
        if(json_error)
            message(FATAL_ERROR "Incomplete private Qt Quick provenance: ${field}")
        endif()
    endforeach()
    file(SHA256 "${library}" library_sha256)
    file(READ "${LICASA_RUNTIME_SOURCE_ROOT}/packaging/qt-backport.lock.json" lock)
    string(JSON source_sha256 GET "${lock}" sha256)
    if(NOT actual_runtime_profile STREQUAL LICASA_RUNTIME_PROFILE OR
            NOT actual_qt_version VERSION_EQUAL LICASA_RUNTIME_QT_VERSION OR
            NOT actual_library_sha256 STREQUAL library_sha256 OR
            NOT actual_source_sha256 STREQUAL source_sha256)
        message(FATAL_ERROR "Private Qt Quick does not match ${LICASA_RUNTIME_PROFILE}, its pinned source, or its recorded hash")
    endif()
    string(JSON patch GET "${lock}" patch)
    file(SHA256 "${LICASA_RUNTIME_SOURCE_ROOT}/${patch}" expected_sha256)
    string(JSON count ERROR_VARIABLE json_error LENGTH "${receipt}" patches)
    if(json_error OR NOT count EQUAL 1)
        message(FATAL_ERROR "Private Qt Quick requires exactly its qualified cleanup patch")
    endif()
    string(JSON actual_sha256 ERROR_VARIABLE json_error GET "${receipt}" patches "${patch}")
    if(json_error OR NOT actual_sha256 STREQUAL expected_sha256)
        message(FATAL_ERROR "Private Qt Quick requires current patch: ${patch}")
    endif()
endfunction()

function(licasa_verify_ffmpeg_runtime plugin)
    get_filename_component(runtime_dir "${plugin}" DIRECTORY)
    if(NOT EXISTS "${runtime_dir}/build.json")
        message(FATAL_ERROR "Private FFmpeg plugin requires its matching build.json provenance; rebuild with tools/build_qt_ffmpeg.py")
    endif()
    file(READ "${runtime_dir}/build.json" receipt)
    foreach(field runtime_profile qt_version plugin_sha256 source_sha256)
        string(JSON actual_${field} ERROR_VARIABLE json_error GET "${receipt}" "${field}")
        if(json_error)
            message(FATAL_ERROR "Incomplete private FFmpeg provenance: ${field}")
        endif()
    endforeach()
    file(SHA256 "${plugin}" plugin_sha256)
    file(READ "${LICASA_RUNTIME_FFMPEG_LOCK}" lock)
    string(JSON source_sha256 GET "${lock}" sha256)
    if(NOT actual_runtime_profile STREQUAL LICASA_RUNTIME_PROFILE OR
            NOT actual_qt_version VERSION_EQUAL LICASA_RUNTIME_QT_VERSION OR
            NOT actual_plugin_sha256 STREQUAL plugin_sha256 OR
            NOT actual_source_sha256 STREQUAL source_sha256)
        message(FATAL_ERROR "Private FFmpeg plugin does not match ${LICASA_RUNTIME_PROFILE}, its pinned source, or its recorded hash")
    endif()
    string(JSON count LENGTH "${lock}" patches)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON patch GET "${lock}" patches ${index})
        file(SHA256 "${LICASA_RUNTIME_SOURCE_ROOT}/${patch}" expected_sha256)
        string(JSON actual_sha256 ERROR_VARIABLE json_error GET "${receipt}" patches "${patch}")
        if(json_error OR NOT actual_sha256 STREQUAL expected_sha256)
            message(FATAL_ERROR "Private FFmpeg plugin requires current patch: ${patch}")
        endif()
    endforeach()
    if(LICASA_RUNTIME_PROFILE STREQUAL "debian-6.8.2")
        string(JSON expected_sha256 GET "${lock}" debian_patch_sha256)
        string(JSON count LENGTH "${lock}" debian_patches)
        math(EXPR last "${count} - 1")
        set(expected_patches)
        foreach(index RANGE ${last})
            string(JSON patch GET "${lock}" debian_patches ${index})
            list(APPEND expected_patches "${patch}")
        endforeach()
    else()
        string(JSON expected_sha256 GET "${lock}" ubuntu_patch_sha256)
        string(JSON patch GET "${lock}" ubuntu_abi_patch)
        set(expected_patches "${patch}")
    endif()
    string(JSON actual_sha256 ERROR_VARIABLE json_error GET "${receipt}" distro_patch_sha256)
    if(json_error OR NOT actual_sha256 STREQUAL expected_sha256)
        message(FATAL_ERROR "Private FFmpeg plugin requires the pinned distro source patches")
    endif()
    string(JSON count ERROR_VARIABLE json_error LENGTH "${receipt}" distro_patches)
    list(LENGTH expected_patches expected_count)
    if(json_error OR NOT count EQUAL expected_count)
        message(FATAL_ERROR "Private FFmpeg plugin requires the exact selected distro patches")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        list(GET expected_patches ${index} expected_patch)
        string(JSON actual_patch GET "${receipt}" distro_patches ${index})
        if(NOT actual_patch STREQUAL expected_patch)
            message(FATAL_ERROR "Private FFmpeg plugin distro patch selection changed: ${expected_patch}")
        endif()
    endforeach()
    foreach(feature_set required_features disabled_features)
        string(JSON count LENGTH "${lock}" "${feature_set}")
        string(JSON actual_count ERROR_VARIABLE json_error LENGTH "${receipt}" "${feature_set}")
        if(json_error OR NOT count EQUAL actual_count)
            message(FATAL_ERROR "Private FFmpeg plugin must retain the qualified ${feature_set}")
        endif()
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE ${last})
                string(JSON expected_feature GET "${lock}" "${feature_set}" ${index})
                string(JSON actual_feature GET "${receipt}" "${feature_set}" ${index})
                if(NOT actual_feature STREQUAL expected_feature)
                    message(FATAL_ERROR "Private FFmpeg plugin feature contract changed: ${expected_feature}")
                endif()
            endforeach()
        endif()
    endforeach()

endfunction()
